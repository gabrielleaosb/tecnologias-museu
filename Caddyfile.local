{$DOMAIN:localhost} {
	tls internal

	# Mesma divisão do Caddyfile de produção — ver comentários lá.
	handle_path /videos/* {
		root * /srv/videos
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle_path /uploads/* {
		root * /srv/uploads
		file_server
	}

	handle {
		reverse_proxy web:3000
	}
}
