{$DOMAIN} {
	# Estáticos pesados são servidos pelo Caddy direto do disco. Sem estes
	# blocos tudo cai no reverse_proxy e os 42 MB de vídeo da Sala 1 passam
	# pelo processo Node a cada requisição — o mesmo processo que mantém os
	# WebSockets de sincronização das telas.
	#
	# Os caminhos /srv/* vêm dos volumes montados no serviço caddy
	# (docker-compose.yml): os vídeos por bind mount do repositório, os uploads
	# pelo volume nomeado que o web escreve.
	handle_path /videos/* {
		root * /srv/videos
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle_path /uploads/* {
		root * /srv/uploads
		file_server
	}

	# `handle` (e não um reverse_proxy solto) para que os blocos acima sejam
	# realmente exclusivos — um reverse_proxy no topo casaria com tudo.
	handle {
		reverse_proxy web:3000
	}
}
